{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "revo",
      "camelcase": "Revo",
      "title": "Revo",
      "scope": "source.revo",
      "file-types": [
        "rv"
      ],
      "injection-regex": "^revo$",
      "class-name": "TreeSitterRevo",
      "highlights": ["queries/highlights.scm"]
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "revo is a dynamic language made for the joy or programming",
    "authors": [
      {
        "name": "doomy",
        "url": ""
      }
    ],
    "links": {
      "repository": "https://github.com/if-not-nil/revo/",
      "funding": ""
    }
  },
  "bindings": {
    "c": false,
    "go": false,
    "java": false,
    "node": true,
    "python": false,
    "rust": false,
    "swift": false,
    "zig": false
  }
}
