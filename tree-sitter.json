{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "revo",
      "camelcase": "Revo",
      "title": "Revo",
      "scope": "source.revo",
      "file-types": [
        "rv",
        "revo"
      ],
      "injection-regex": "^revo$",
      "class-name": "TreeSitterRevo",
      "highlights": [
        "queries/highlights.scm"
      ]
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Tree-sitter grammar for Revo",
    "authors": [
      {
        "name": "doomy",
        "url": ""
      },
      {
        "name": "Idan Gilboa",
        "url": "https://github.com/w0x7y"
      }
    ],
    "links": {
      "repository": "https://github.com/w0x7y/tree-sitter-revo",
      "funding": ""
    }
  },
  "bindings": {
    "c": false,
    "go": false,
    "java": false,
    "node": true,
    "python": false,
    "rust": false,
    "swift": false,
    "zig": false
  }
}
